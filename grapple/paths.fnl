;; Don't reformat this. Nothing will break, but it gets hard to read.
;;
;; We could randomly inject S or ▶ into any ├─── segments.
; 
;; If you want something to be more likely to be picked, duplicate it.
;; 
;; Key
;; ◀ -- connects to cell
;; ◁ -- end of path
;; ▶ -- infinite repeater
;; S -- colour switcher
; 
(local paths [
  ["───────────"]
  ["───────────"]
  ["───────────"]

  ["─────◁     "] 

  ["─────▶─────"]

  ["────────▶──"]

  ["─────▶──▶──"]

  ["─────S─────"]
  ["────────S──"]

  ["────┐      "
   "──◁ ├──────"
   "────┘      "]

  ["────┐      "
   "──◁ ├───▶──"
   "────┘      "]

  ["────┐      "
   "──◁ ├──────"
   "────┘      "]

  ["────┐      "
   "──◁ ├──────"
   "──▶─┘      "]

  ["────◁  ┌───"
   "────▶──┤   "
   "────◁  └───"]

  ["─────◁ ┌───"
   "───────┤   "
   "─────◁ └───"]
  ["─────◁ ┌───"
   "───────┤   "
   "─────◁ └───"]

  ["─────◁ ┌───"
   "───────┤   "
   "─────◁ └─▶─"]

  ["─────◁ ┌───"
   "───────┤   "
   "─────◁ └─S─"]

  ["   ┌───┐   "
   "───┤   ├───"
   "   └───┘   "]
   
  ["────┐      "
   "──◁ ├──────"
   "────┘  ┌───" 
   "───────┤   "
   "─────◁ └───"]

  ["───────┐   "
   "────┐  ├───"
   "──◁ ├──┘   "
   "────┘      "]

  ["─────◁ ┌───"
   "──◁ ┌──┤   "
   "────┤  └───"
   "──◁ └──────"]
  ])

{: paths}
