{:number-of-cells 12
 ;; colours of things
 :gcol {:background [0.7 0.2 0.2]
        :left [0.7 0.7 0.2]
        :right [0.2 0.2 0.7]
        :lines [0 0 0]}
 :pip-ttl 5
 ;; sizes of things
 :size {:window {:width 1000 :height 750}}
 ;; game control keys
 :keys {:up :p
        :down :l
        :left :q
        :right: :w
        :fire "return"
        :repeat-delay 0.20
        :repeat-rate 0.10}}
