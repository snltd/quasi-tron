{:size {:window {:width 1000 :height 750}}
 :player {:hp 10
          :pips 3
          :components {:drive nil
                       :power nil
                       :weapon nil
                       :chassis nil
                       :devices nil}}
 :keys {:up :p
        :down :l
        :left :q
        :right :w
        :fire "return"
        :repeat-delay 0.20
        :repeat-rate 0.10}}
